# Copy to .env and fill in. Everything is optional: with nothing set the
# system runs read-only against the public RPC in PAPER mode.

# --- Identity (owner decides) ---------------------------------------------
CT_AGENT_NAME="CT Agent"
CT_AGENT_TICKER=
CT_AGENT_TOKEN_ADDRESS=        # project token, once launched (disclosed in posts)
CT_TREASURY_ADDRESS=           # public treasury/creator-fee wallet (disclosure only; key NEVER goes here)

# --- Robinhood Chain --------------------------------------------------------
# Public RPC is rate limited. For production use a provider, e.g.
# https://robinhood-mainnet.g.alchemy.com/v2/<KEY>
CT_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Log scans stay on the public node (Alchemy free tier caps log queries at 10 blocks)
CT_LOGS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CT_LAUNCH_BACKFILL_HOURS=168

# --- Muse Spark (Meta Model API, US developers during preview) -------------
CT_MUSE_API_KEY=
CT_MUSE_MODEL=muse-spark-1.3   # do NOT use the -contributor tier: Meta trains on those prompts

# --- X API (pay per use) ----------------------------------------------------
CT_X_BEARER_TOKEN=             # app-only token for reads
CT_X_USER_ACCESS_TOKEN=        # OAuth2 user token for the bot account (tweet.write)
CT_X_POSTING_ENABLED=false     # drafts queue up until this is true
CT_X_DAILY_POST_CAP=6
CT_X_MONTHLY_READ_BUDGET=20000

# --- Twitch -----------------------------------------------------------------
CT_TWITCH_CLIENT_ID=
CT_TWITCH_CLIENT_SECRET=
CT_TWITCH_EVENTSUB_SECRET=     # 10-100 random chars
CT_TWITCH_CHANNELS=[]          # JSON list, e.g. ["streamer1","streamer2"]

# --- News (JSON list; add |first_party for a project's own feed) -----------
# Vetted, working feeds (checked 2026-09-23). Robinhood's newsroom has no RSS feed; CryptoSlate blocks cloud servers.
CT_NEWS_FEEDS=["https://www.coindesk.com/arc/outboundfeeds/rss/","https://cointelegraph.com/rss","https://decrypt.co/feed","https://www.theblock.co/rss.xml","https://thedefiant.io/api/feed","https://blog.arbitrum.io/rss/"]

# --- Trading & risk ---------------------------------------------------------
CT_TRADING_MODE=paper
CT_PAPER_STARTING_BALANCE_ETH=1.0
CT_MAX_POSITION_ETH=0.05
CT_MAX_OPEN_POSITIONS=3
CT_MAX_TOTAL_EXPOSURE_ETH=0.15
CT_MAX_DAILY_LOSS_ETH=0.05
CT_MAX_SLIPPAGE_BPS=300
CT_STOP_LOSS_PCT=70
CT_TAKE_PROFIT_LADDER=[[1.6,0.5],[2.0,0.25]]
CT_MAX_HOLD_HOURS=24

# Live trading. Leave empty until paper results are reviewed.
# Separate small wallet ONLY. Never the owner or treasury key.
CT_TRADING_WALLET_PRIVATE_KEY=
CT_LIVE_EXECUTION_REVIEWED=false

# --- API --------------------------------------------------------------------
CT_API_ADMIN_TOKEN=            # long random string; admin endpoints are off without it

# Smart-money scanner (Supabase) that supplies the coins
CT_SUPABASE_URL=
CT_SUPABASE_KEY=
