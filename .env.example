# ct-agent (VIGIL) settings. Copy this file to .env and fill in what you need: cp .env.example .env
#
# * Everything is optional. With nothing set, the bot runs read-only against the public Solana RPC and
#   Jupiter's keyless lane, in PAPER mode (simulated trades), with posting, the launchpad and the public chat OFF.
# * Lines marked [SECRET] are credentials. They belong in .env (gitignored) or your host's secret store
#   (e.g. Railway Variables), NEVER in git, an issue, a screenshot or a chat. If one leaks, revoke it.
# * Lines starting with "# CT_" show the default; uncomment to change it.
# * Lists and the take-profit ladder are JSON, e.g. CT_SITE_ORIGINS=["https://example.com"].
# * Run `ctagent check` after editing: it tests each connection and prints a safety review.

# =============================================================================
# Identity: who the bot is
# =============================================================================
CT_AGENT_NAME=VIGIL
CT_AGENT_TICKER=VIGIL                 # the project's own coin ticker; the launchpad won't launch a copy of it
# the bot's X handle, without the @ (needed for the launchpad)
CT_X_HANDLE=
# the project's own token mint (base58), once launched (disclosed in posts)
CT_AGENT_TOKEN_ADDRESS=
# public treasury/creator-fee wallet ADDRESS (base58), for disclosure (never its key)
CT_TREASURY_ADDRESS=
# CT_SKIP_TOKENS=[]                   # mints never to trade, e.g. your own older coins (case-sensitive)

# =============================================================================
# Storage
# =============================================================================
# CT_DATABASE_PATH=data/vigil.db      # SQLite; keep data/ on a persistent volume in production
# CT_KILL_SWITCH_FILE=data/KILL       # while this file exists, no new trades are opened

# =============================================================================
# Solana
# =============================================================================
# The public RPC is rate limited and "not intended for production". Use a provider such as Helius
# (https://dashboard.helius.dev, free tier is enough to start); Helius also serves coin metadata (DAS getAsset).
# CT_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<KEY>   [SECRET: the URL contains your key]
CT_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# answers when the main RPC is out of retries
CT_SOLANA_BACKUP_RPC_URL=https://api.mainnet-beta.solana.com
# CT_RPC_TIMEOUT_S=20
# CT_EXPLORER_URL=https://solscan.io

# =============================================================================
# Jupiter: swaps and prices
# =============================================================================
# Free key at https://developers.jup.ag (about 1 request a second). Without one Jupiter is slower and may refuse
# swaps, so set it before going live.
# CT_JUPITER_API_URL=https://api.jup.ag
# [SECRET]
CT_JUPITER_API_KEY=

# =============================================================================
# Market data (public APIs, no keys)
# =============================================================================
# CT_GECKOTERMINAL_NETWORK=solana
# CT_DEXSCREENER_CHAIN=solana

# =============================================================================
# Grok, the bot's brain (xAI API)
# =============================================================================
# Create a key at https://console.x.ai (API Keys). This is NOT one of the X developer keys below.
# Without it the bot still screens and paper-trades scanner calls, but writes no analysis or posts.
# [SECRET]
CT_GROK_API_KEY=
# CT_GROK_BASE_URL=https://api.x.ai/v1
# CT_GROK_MODEL=grok-4.7
# CT_GROK_FALLBACK_MODELS=["grok-4.3"]   # tried in order if the main model isn't available
# CT_GROK_TIMEOUT_S=90

# =============================================================================
# X (Twitter): reading and posting
# =============================================================================
# Create an app at https://developer.x.com (Projects & Apps), on the account the bot posts from.
# Reads need the app's Bearer token. Posting needs EITHER the OAuth 1.0a keys (simplest, never expire)
# OR the OAuth 2.0 client id/secret plus a one-time `ctagent x-login`.
# [SECRET] app-only token, for reads
CT_X_BEARER_TOKEN=
# [SECRET] OAuth 1.0a Consumer Key
CT_X_API_KEY=
# [SECRET] OAuth 1.0a Consumer Secret
CT_X_API_SECRET=
# [SECRET] OAuth 1.0a Access Token (the bot account)
CT_X_ACCESS_TOKEN=
# [SECRET] OAuth 1.0a Access Token Secret
CT_X_ACCESS_SECRET=
# OAuth 2.0 client id (only if you use x-login)
CT_X_CLIENT_ID=
# [SECRET] OAuth 2.0 client secret
CT_X_CLIENT_SECRET=
# [SECRET] printed by `ctagent x-login`
CT_X_REFRESH_TOKEN=
# [SECRET] a short-lived OAuth 2.0 user token (alternative to the above)
CT_X_USER_ACCESS_TOKEN=
CT_X_POSTING_ENABLED=false            # posts queue up as drafts until this is true
CT_X_AUTO_REPLY_ENABLED=false         # reply to people who mention the bot
CT_X_MUSINGS_ENABLED=false            # original market musings between trade posts
# CT_X_THREADS_SINCE=                 # ISO time; posts before it belong to an older account (no replies under them)
# CT_X_REPLIES_PER_DAY=30
# CT_X_REPLIES_PER_USER_DAY=2
# CT_X_MENTIONS_POLL_MIN=3
# CT_X_MUSING_EVERY_MIN=30
# CT_X_GOALS_ENABLED=false            # posts about what VIGIL is aiming for next and what its data has taught it
# CT_X_GOALS_EVERY_HOURS=6
# CT_X_CADENCE_MIN=17                 # a timeline post at least this often (0 = off)
# CT_X_DAILY_POST_CAP=60              # safety net on posts per day
# CT_X_UPDATE_STEP_PCT=50             # post an update at every +50% on an open trade
# CT_X_UPDATE_DOWN_PCT=[-15]          # and once when it's down this much
# CT_X_MAX_READS_PER_SEARCH=20
# CT_X_MONTHLY_READ_BUDGET=6000       # X reads are paid per use: this caps the monthly spend

# =============================================================================
# Twitch (optional: stream chat as a sentiment source)
# =============================================================================
# App at https://dev.twitch.tv/console. EventSub posts to POST /webhooks/twitch on your API.
CT_TWITCH_CLIENT_ID=
# [SECRET]
CT_TWITCH_CLIENT_SECRET=
# [SECRET] 10-100 random characters you choose
CT_TWITCH_EVENTSUB_SECRET=
CT_TWITCH_CHANNELS=[]                 # e.g. ["streamer1","streamer2"]

# =============================================================================
# News (RSS feeds; append |first_party for a project's own feed)
# =============================================================================
CT_NEWS_FEEDS=["https://www.coindesk.com/arc/outboundfeeds/rss/","https://cointelegraph.com/rss","https://decrypt.co/feed","https://www.theblock.co/rss.xml","https://thedefiant.io/api/feed"]

# =============================================================================
# Where trade ideas come from
# =============================================================================
# Calls from a smart-money scanner stored in Supabase (table alert_performance, rows with chain=solana). You need
# your own scanner feeding it; without one the bot has nothing to trade.
# https://<project-ref>.supabase.co
CT_SUPABASE_URL=
# [SECRET] a key that can read the scanner's tables
CT_SUPABASE_KEY=
# optional second call source, in its own Supabase project
CT_FIBBOT_SUPABASE_URL=
# [SECRET]
CT_FIBBOT_SUPABASE_KEY=
# CT_SCANNER_TRIGGER_PCT=30           # a call becomes a candidate once the coin is up this much...
# CT_SCANNER_WINDOW_HOURS=6           # ...within this long of the call
# CT_SCANNER_MAIN_ENABLED=true
# CT_SCANNER_BUY_ON_CALL=false        # buy every tradeable call at once, without waiting for the trigger
# CT_DECISION_COOLDOWN_MIN=30         # don't re-ask Grok about the same coin too often
# CT_CANDIDATES_PER_CYCLE=5
# CT_RESEARCH_WAIT_MIN=10             # wait this long for a coin's X research before deciding without it

# =============================================================================
# Screening (prototype filters, not a strategy)
# =============================================================================
# CT_MIN_VOLUME_H1_USD=5000
# CT_MIN_LIQUIDITY_USD=15000
# CT_MAX_TRANSFER_FEE_BPS=0           # Token-2022 coins taxing transfers above this are never traded
# CT_MIN_INDEPENDENT_SOURCES_FOR_BUY=0
# CT_MAX_DEPLOYER_BUY_SHARE=0.30
# CT_MAX_DEPLOYER_HOLD_SHARE=0.10    # the creator's share of the supply
# CT_MAX_TOP10_HOLD_SHARE=0.35        # the 10 biggest wallets (curves, pools and burns not counted)
# CT_MAX_TOP_BUYER_SHARE=0.40

# =============================================================================
# Trading and risk limits (apply to paper and live alike)
# =============================================================================
CT_TRADING_MODE=paper                 # paper | live. Stay on paper until you've reviewed weeks of results.
# CT_PAPER_STARTING_BALANCE_SOL=10
# CT_MAX_POSITION_SOL=0.5             # hard cap on one trade
# CT_POSITION_SIZE_PCT=0              # size as % of the account; 0 = every trade is CT_MAX_POSITION_SOL
# CT_MAX_OPEN_POSITIONS=3
# CT_MAX_TOTAL_EXPOSURE_SOL=1.5
# CT_MAX_DAILY_LOSS_SOL=0.5
# CT_MAX_ENTRIES_PER_DAY=10
# CT_MAX_SLIPPAGE_BPS=300             # also the price-impact bound: a swap moving the price more is refused
# CT_STOP_LOSS_PCT=70
# CT_TAKE_PROFIT_LADDER=[[1.5,0.5],[2.0,0.25]]   # [price multiple, share of the original position to sell]
# CT_MAX_HOLD_HOURS=24

# =============================================================================
# Live trading: REAL MONEY. Read SECURITY.md first.
# =============================================================================
# Live trades need ALL of: CT_TRADING_MODE=live, CT_LIVE_EXECUTION_REVIEWED=true, a trading wallet key, and a
# CT_API_ADMIN_TOKEN of 32+ characters (the bot refuses to start live without one).
# Use a NEW Solana wallet made only for this bot (e.g. a fresh Phantom wallet: Settings > Manage accounts >
# Show private key gives the base58 key), holding only what you can afford to lose. Never your main wallet,
# never a treasury or launcher key. Anyone who reads this value can take everything in that wallet.
# [SECRET] base58 private key, or a solana-keygen JSON byte array
CT_TRADING_WALLET_PRIVATE_KEY=
CT_LIVE_EXECUTION_REVIEWED=false      # set true only after you've read execution/live.py and tested it
# CT_LIVE_VENUE=jupiter              # jupiter (the bot signs Jupiter-built swaps) | gmgn (GMGN's trading API)
# [SECRET] only with CT_LIVE_VENUE=gmgn
CT_GMGN_API_KEY=
# [SECRET] the Ed25519 key GMGN checks signatures against (PEM, not a wallet key)
CT_GMGN_PRIVATE_KEY=
# CT_GMGN_HOST=https://openapi.gmgn.ai
# CT_GMGN_CHAIN=sol
# CT_GMGN_SLIPPAGE_PCT=0              # 0 = GMGN's auto slippage

# =============================================================================
# Launchpad: launch pump.fun coins for people who ask the bot on X (spends SOL)
# =============================================================================
# Each coin's creator fees are split once, at launch (pump.fun then locks the split): the requester's share
# below, the rest to the launcher wallet.
CT_LAUNCHPAD_ENABLED=false
# [SECRET] its OWN small wallet (base58 key), never the trading wallet; fund it with ~0.5 SOL
CT_LAUNCHER_WALLET_PRIVATE_KEY=
# CT_LAUNCH_DAILY_CAP_SOL=0.5
# CT_LAUNCH_DEV_BUY_SOL=0             # optional first buy by the launcher at creation
# CT_LAUNCH_CREATOR_SHARE_BPS=9000    # the requester's share of creator fees
# CT_LAUNCH_FEE_SPLIT_VERIFIED=false  # true once `ctagent launch-test` has locked a real fee split
# CT_LAUNCH_PER_USER_DAY=1
# CT_LAUNCH_VIP_HANDLES=[]
# CT_LAUNCH_VIP_PER_DAY=10
# CT_LAUNCH_MIN_ACCOUNT_DAYS=30
# CT_PUMPPORTAL_URL=https://pumpportal.fun/api/trade-local
# [SECRET] uploads each coin's image and metadata to IPFS (https://app.pinata.cloud, API Keys > JWT)
CT_PINATA_JWT=

# =============================================================================
# API and website
# =============================================================================
# Admin endpoints (/admin/*: kill switch, hand-written posts) are OFF while this is empty.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# [SECRET] 32+ random characters
CT_API_ADMIN_TOKEN=
# Websites allowed to call the API from a browser (CORS). Add your site's https:// origin(s).
# CT_SITE_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Public "Ask VIGIL" chat on the site. Every question is a paid Grok call, capped per visitor and per day.
CT_CHAT_ENABLED=false
# CT_CHAT_PER_IP_HOUR=10
# CT_CHAT_PER_IP_DAY=30
# CT_CHAT_GLOBAL_DAY=500              # the hard ceiling on chat spend
# CT_CHAT_MAX_CHARS=500
# CT_CHAT_X_LOOKUPS_DAY=50
# CT_SCORE_SINCE=                     # ISO time; the site's scorecard counts trades from then on
# CT_SCORE_HISTORY_V1={}              # earlier paper history to show (SOL), e.g. {"trades":100,"wins":54,"losses":46}
# CT_API_HOST=127.0.0.1               # run-all's API address (0.0.0.0 automatically when PORT is set)
